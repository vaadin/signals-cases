## Local-build Dockerfile (option B).
##
## Builds nothing inside the image. Expects the production jar to already
## exist on disk:
##
##   mvn -pl text-selection -am clean package -Pproduction -DskipTests
##
## Then deploy with:
##
##   flyctl deploy --dockerfile text-selection/Dockerfile.local
##
## This avoids resolving the locally-published flow-components 25.2-SNAPSHOT
## inside Fly's builder, which doesn't have access to your ~/.m2.

FROM eclipse-temurin:25-jre-alpine

WORKDIR /app
COPY text-selection/target/text-selection-use-cases-*.jar /app/app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar", "--spring.profiles.active=prod"]
